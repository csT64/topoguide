# /etc/wp-security-monitor/config.conf
# Configuration de wp-security-monitor.sh (cahier des charges v1.1)
# Permissions attendues : root:root 640

# Sites WordPress surveillés (les noms de base doivent être uniques)
SITES=(
"/srv/www/pro_mono"
"/srv/www/fermewp_prod"
)

# Répertoire des états de référence (root:root 750)
STATE_DIR="/var/lib/wp-security-monitor"

# Répertoire des logs (root:root 750)
LOG_DIR="/var/log/wp-security-monitor"

# Destinataire des alertes (vide = pas de mail, console/log uniquement)
MAIL_TO="administrateur@example.com"

# Commande d'envoi de mail (doit accepter : $MAIL_CMD -s "sujet" destinataire < corps)
MAIL_CMD="mail"

# Utilisateur non privilégié pour l'exécution de WP-CLI (§ 3.2 du cahier des charges).
# WP-CLI charge du code PHP du site : ne jamais l'exécuter en root.
WP_CLI_USER="www-data"

# Binaire WP-CLI
WP_CLI_BIN="wp"

# Utilisateurs dont les crontabs sont surveillées (§ 8.9)
CRON_USERS=("root" "aadt" "www-data")

# Nombre d'écarts fichiers à partir duquel l'alerte passe en CRITIQUE (§ 9)
MASS_CHANGE_THRESHOLD=20
